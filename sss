-- Danh sách trẻ
local function populateChildren()
    for _, c in ipairs(childList:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end
    local r = root()
    local list = {}
    for _, m in ipairs(cache.children) do
        local p = partOf(m)
        if p then
            local d = r and math.floor((p.Position - r.Position).Magnitude) or 0
            table.insert(list, { m = m, d = d })
        end
    end
    table.sort(list, function(a, b) return a.d < b.d end)

    if #list == 0 then
        local e = Instance.new("TextLabel")
        e.Size = UDim2.new(1, -4, 0, 24); e.BackgroundTransparency = 1
        e.Text = "Không thấy trẻ nào"; e.TextColor3 = Color3.fromRGB(150, 150, 165)
        e.Font = Enum.Font.Gotham; e.TextSize = 11; e.Parent = childList
        return
    end
    for i, item in ipairs(list) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -4, 0, 26); b.BackgroundColor3 = C_ROW; b.BorderSizePixel = 0
        b.Text = string.format("%d. %s  (%dm)", i, item.m.Name, item.d)
        b.TextColor3 = C_TXT; b.Font = Enum.Font.Gotham; b.TextSize = 11
        b.TextXAlignment = Enum.TextXAlignment.Left; b.Parent = childList
        corner(b, 6)
        local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 6); pad.Parent = b
        b.MouseButton1Click:Connect(function() tpTo(item.m) end)
    end
end
