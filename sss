-- ================= CONFIG =================
local CFG = {
    Speed = false, WalkSpeed = 40,
    Jump = false, JumpPower = 90,
    Fly = false, FlySpeed = 60,
    KillAura = false, KillRadius = 40,
    AutoChop = false, ChopRadius = 120,
    ESPChild = false,
    Fullbright = false,
    Tool = "Old Axe",
    Delay = 0.25,
}

local CHILD_KEY = "Lost Child"
local ANIMAL_KEYS = { "Wolf", "Bear", "Boar", "Deer", "Rabbit", "Fox", "Cultist" }
local DROP_KEYS = { "Ladder", "Chair", "Head" }

local cache = { animals = {}, trees = {}, children = {} }

-- ================= HELPERS =================
local function hasKey(name, keys)
    local n = string.lower(name)
    for _, k in ipairs(keys) do
        if string.find(n, string.lower(k), 1, true) then return true end
    end
    return false
end

local function root()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function hum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function partOf(m)
    if not m then return nil end
    if m:IsA("BasePart") then return m end
    return m:FindFirstChildWhichIsA("BasePart", true)
end

local function getTool()
    local inv = LP:FindFirstChild("Inventory")
    local t = inv and inv:FindFirstChild(CFG.Tool)
    if not t and LP.Character then t = LP.Character:FindFirstChild(CFG.Tool) end
    return t
end

local function getFirePart()
    local map = Workspace:FindFirstChild("Map")
    local camp = map and map:FindFirstChild("Campground")
    local fire = camp and camp:FindFirstChild("MainFire", true)
    return fire and partOf(fire)
end

local function scan()
    local map = Workspace:FindFirstChild("Map")
    local foliage = map and map:FindFirstChild("Foliage")
    cache.trees = foliage and foliage:GetChildren() or {}

    local animals, children = {}, {}
    for _, o in ipairs(Workspace:GetDescendants()) do
        if o:IsA("Model") then
            if string.find(o.Name, CHILD_KEY, 1, true) then
                table.insert(children, o)
            elseif hasKey(o.Name, ANIMAL_KEYS) and o:FindFirstChildOfClass("Humanoid") then
                table.insert(animals, o)
            end
        end
    end
    cache.animals, cache.children = animals, children
end

task.spawn(function()
    while true do
        pcall(scan)
        task.wait(1)
    end
end)

-- ================= COMBAT LOOP (remote gốc) =================
task.spawn(function()
    while true do
        task.wait(CFG.Delay)
        if (CFG.KillAura or CFG.AutoChop) and EquipRE and UnequipRE and DamageRF then
            local r, tool = root(), getTool()
            if r and tool then
                local handle = tool:FindFirstChild("Handle")
                local dbg = ""
                if handle then
                    local ok, id = pcall(function() return handle:GetDebugId(2) end)
                    if ok and id then dbg = id end
                end

                pcall(EquipRE.FireServer, EquipRE, "FireAllClients", tool)

                if CFG.KillAura then
                    for _, m in ipairs(cache.animals) do
                        local p = partOf(m)
                        local h = m:FindFirstChildOfClass("Humanoid")
                        if p and h and h.Health > 0 and (p.Position - r.Position).Magnitude <= CFG.KillRadius then
                            pcall(DamageRF.InvokeServer, DamageRF, m, tool, dbg, CFrame.new(p.Position))
                        end
                    end
                end

                if CFG.AutoChop then
                    local best, bestD
                    for _, t in ipairs(cache.trees) do
                        local p = partOf(t)
                        if p then
                            local d = (p.Position - r.Position).Magnitude
                            if d <= CFG.ChopRadius and (not bestD or d < bestD) then
                                best, bestD = t, d
                            end
                        end
                    end
                    if best then
                        local p = partOf(best)
                        pcall(DamageRF.InvokeServer, DamageRF, best, tool, dbg, CFrame.new(p.Position))
                    end
                end

                pcall(UnequipRE.FireServer, UnequipRE, "FireAllClients", tool)
            end
        end
    end
end)

-- ================= MOVEMENT =================
RunService.Heartbeat:Connect(function()
    local h = hum()
    if not h then return end
    if CFG.Speed and h.WalkSpeed ~= CFG.WalkSpeed then h.WalkSpeed = CFG.WalkSpeed end
    if CFG.Jump then
        h.UseJumpPower = true
        if h.JumpPower ~= CFG.JumpPower then h.JumpPower = CFG.JumpPower end
    end
end)

local flyBV, flyBG
local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
end
local function startFly()
    stopFly()
    local r = root(); if not r then return end
    flyBV = Instance.new("BodyVelocity"); flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5); flyBV.Parent = r
    flyBG = Instance.new("BodyGyro"); flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5); flyBG.P = 1e4; flyBG.Parent = r
    task.spawn(function()
        while CFG.Fly and flyBV and flyBV.Parent do
            local cam = Workspace.CurrentCamera
            local h = hum()
            local md = h and h.MoveDirection or Vector3.zero
            local v = Vector3.zero
            if md.Magnitude > 0 then
                v = (cam.CFrame.LookVector * -md.Z + cam.CFrame.RightVector * md.X) * CFG.FlySpeed
                v = v + Vector3.new(0, cam.CFrame.LookVector.Y * CFG.FlySpeed * -md.Z, 0)
            end
            flyBV.Velocity = v
            flyBG.CFrame = cam.CFrame
            task.wait()
        end
        stopFly()
    end)
end

-- ================= ESP TRẺ =================
local espTag = {}
local function setESPChild(on)
    if on then return end
    for _, hl in pairs(espTag) do if hl then hl:Destroy() end end
    espTag = {}
end
task.spawn(function()
    while true do
        task.wait(1)
        if CFG.ESPChild then
            for _, m in ipairs(cache.children) do
                if m.Parent and not espTag[m] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(255, 220, 80)
                    hl.OutlineColor = Color3.fromRGB(255, 220, 80)
                    hl.FillTransparency = 0.6
                    hl.Adornee = m; hl.Parent = m
                    espTag[m] = hl
                end
            end
        end
    end
end)

-- ================= FULLBRIGHT =================
local fbPrev
local function setFullbright(on)
    if on then
        fbPrev = fbPrev or { B = Lighting.Brightness, C = Lighting.ClockTime, F = Lighting.FogEnd }
        Lighting.Brightness = 3; Lighting.ClockTime = 12; Lighting.FogEnd = 1e6
    elseif fbPrev then
        Lighting.Brightness = fbPrev.B; Lighting.ClockTime = fbPrev.C; Lighting.FogEnd = fbPrev.F
        fbPrev = nil
    end
end

-- ================= TP =================
local function tpTo(m)
    local r, p = root(), partOf(m)
    if r and p then r.CFrame = CFrame.new(p.Position + Vector3.new(0, 4, 0)) end
end

local function tpCampfire()
    local fp = getFirePart()
    if fp then
        local r = root()
        if r then r.CFrame = CFrame.new(fp.Position + Vector3.new(0, 4, 0)) end
    end
end

local function revealMap()
    if not MapRE then return end
    local cells = {}
    for r = 1, 64 do for c = 1, 64 do table.insert(cells, { Row = r, Col = c }) end end
    for i = 1, #cells, 200 do
        local b = {}
        for j = i, math.min(i + 199, #cells) do table.insert(b, cells[j]) end
        pcall(MapRE.FireServer, MapRE, b, {})
        task.wait(0.1)
    end
end

-- ================= DỒN NGUYÊN LIỆU VỀ LỬA TRẠI =================
local function dropToFire()
    local fp = getFirePart()
    if not fp or not DragRE or not StopDragRE then
        warn("[ollie] Thiếu lửa trại hoặc remote kéo thả")
        return 0
    end

    local ch = LP.Character
    local count, seen = 0, {}

    for _, o in ipairs(Workspace:GetDescendants()) do
        if o:IsA("Model") and not seen[o] and hasKey(o.Name, DROP_KEYS) then
            if ch and o:IsDescendantOf(ch) then continue end
            if Players:GetPlayerFromCharacter(o) then continue end
            seen[o] = true

            if not o.PrimaryPart then o.PrimaryPart = partOf(o) end
            if not o.PrimaryPart then continue end

            local offset = Vector3.new(math.random(-30, 30) / 10, 8 + count * 0.4, math.random(-30, 30) / 10)
            local target = fp.Position + offset

            pcall(DragRE.FireServer, DragRE, o)
            pcall(function() o:SetPrimaryPartCFrame(CFrame.new(target)) end)
            task.wait(0.05)
            pcall(StopDragRE.FireServer, StopDragRE, o)

            count = count + 1
            task.wait(0.1)
        end
    end
    return count
end

